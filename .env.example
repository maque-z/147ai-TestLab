SECRET_KEY=change-this-to-a-long-random-string
DEFAULT_USERNAME=147ai
DEFAULT_PASSWORD=
# 自助注册。默认开放：每个账号有自己的 API 配置，新注册者必须填自己的
# api_key 才能生成，烧的是他自己的上游额度，不是部署者的。
# 想关掉改成 false，不需要改代码。
ALLOW_REGISTRATION=true
# 宿主机映射端口，默认 8005。8005 被占时在这里改，不要动 docker-compose.yml。
# 改完记得同步宝塔 Nginx 反代里的 proxy_pass 端口（nginx/baota-snippet.conf）。
BACKEND_PORT=8005
